
# Database type: "sqlite" (default) or "seekdb"
# DB_TYPE=sqlite

# seekdb configuration (only when DB_TYPE=seekdb)
# Embedded mode:
# SEEKDB_PATH=/path/to/data
# SEEKDB_DATABASE=nanoclaw

# Server mode:
# SEEKDB_HOST=127.0.0.1
# SEEKDB_PORT=2881
# SEEKDB_USER=root
# SEEKDB_PASSWORD=
# SEEKDB_DATABASE=nanoclaw
# SEEKDB_TENANT=
