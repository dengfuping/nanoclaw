
# Database type: "sqlite" (default) or "seekdb"
# DB_TYPE=sqlite

# seekdb configuration (only when DB_TYPE=seekdb)
# Embedded mode:
# SEEKDB_PATH=/path/to/data
# SEEKDB_DATABASE=nanoclaw

# Server mode:
# SEEKDB_HOST=127.0.0.1
# SEEKDB_PORT=2881
# SEEKDB_USER=root
# SEEKDB_PASSWORD=
# SEEKDB_DATABASE=nanoclaw
# SEEKDB_TENANT=

# Semantic search (requires DB_TYPE=seekdb)
# SEARCH_ENABLED=true             # auto-enabled when DB_TYPE=seekdb
# EMBEDDING_PROVIDER=default      # "default" (local all-MiniLM-L6-v2), or any @seekdb/* provider:
                                  # openai, qwen, ollama, cohere, jina, google-vertex,
                                  # amazon-bedrock, sentence-transformer, siliconflow,
                                  # tencent-hunyuan, voyageai (install separately: npm i @seekdb/<name>)

# Optional: auto-inject relevant context before agent prompt (default: off)
# SEARCH_CONTEXT_ENABLED=false
# SEARCH_CONTEXT_LIMIT=3
